# =============================================================================
# GrantDesk Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets to git.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://grantdesk:grantdesk_dev@localhost:5432/grantdesk

# -----------------------------------------------------------------------------
# Demo / Seed Credentials
# Used in demo mode (no DATABASE_URL) and by the seed script.
# Override these in production to change the seeded demo account.
# -----------------------------------------------------------------------------
DEMO_EMAIL=demo@grantdesk.ca
DEMO_PASSWORD=Password123!

# -----------------------------------------------------------------------------
# Google OAuth (Optional - for social login)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
